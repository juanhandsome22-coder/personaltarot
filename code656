        /* ============================================================================
           9. BESPOKE 2-PARAGRAPH READING SYNTHESIS ENGINE
           ============================================================================ */
        function describeCardMeaning(drawnItem) {
            const { card, isReversed } = drawnItem;
            const orientationLabel = isReversed ? "in its reversed aspect" : "shining upright";
            const coreMeaning = isReversed ? card.reversed : card.upright;
            return `<strong>${card.name}</strong> (${orientationLabel}), which speaks of ${coreMeaning}`;
        }

        function getDominantElementInsight() {
            const counts = { Fire: 0, Water: 0, Air: 0, Earth: 0 };
            let majorCount = 0;
            drawnCards.forEach(d => {
                counts[d.card.element] = (counts[d.card.element] || 0) + 1;
                if (d.card.suit === "Major") majorCount++;
            });

            const sorted = Object.entries(counts).sort((a, b) => b[1] - a[1]);
            const topElement = sorted[0][0];

            const elementThemes = {
                Fire: "dominated by the Sacred Element of Fire, signaling that spiritual willpower, creative courage, and passionate initiative are the primary alchemical forces shaping your path",
                Water: "steeped in the Sacred Element of Water, revealing that deep emotional healing, intuitive receptivity, and heart-centered truth are guiding this chapter beneath the surface",
                Air: "illuminated by the Sacred Element of Air, indicating a pivotal season of mental liberation, radical truth-telling, and clearing away limiting beliefs",
                Earth: "anchored in the Sacred Element of Earth, affirming that grounded patience, nervous-system safety, and tangible stewardship are turning your visions into lived reality"
            };

            const majorNote = majorCount >= Math.ceil(drawnCards.length / 2)
                ? "Furthermore, the high concentration of Major Arcana archetypes confirms that this is no ordinary passing mood, but a fated soul-level initiation guided by higher destiny."
                : "The interplay of Major and Minor Arcana shows that divine synchronicity and your daily practical choices are weaving together hand in hand.";

            return {
                elementLine: elementThemes[topElement],
                majorNote: majorNote
            };
        }

        function generateTwoParagraphReading(spread, question, clientName) {
            const greeting = clientName ? `Beloved ${clientName}, as` : `As`;
            const { elementLine, majorNote } = getDominantElementInsight();

            let p1 = "";
            let p2 = "";

            if (spread.key === "threeCard") {
                const [past, present, future] = drawnCards;
                p1 = `${greeting} we part the gilded veil around your inquiry—<em>“${question}”</em>—the sanctuary spread opens in a current ${elementLine}. Anchoring the roots of your journey in <strong>${past.position.name}</strong> is ${describeCardMeaning(past)}. This foundational energy has directly shaped the threshold where you now stand in <strong>${present.position.name}</strong>, illuminated by ${describeCardMeaning(present)}. ${majorNote} Together, these first two pillars reveal that what you have walked through was never random; it has been tempering your spirit so you can meet this exact present-moment crossroads with awakened eyes.`;

                p2 = `Looking ahead toward <strong>${future.position.name}</strong>, the oracle unveils ${describeCardMeaning(future)}. To harmonize with this unfolding trajectory, Spirit invites you to honor the wisdom of <strong>${past.card.name}</strong> without remaining tethered to old echoes, while channeling the active medicine of <strong>${present.card.name}</strong> (${present.card.keywords.toLowerCase()}) into conscious daily devotion. As you integrate the frequency of <strong>${future.card.name}</strong>, trust that the mist before you is clearing step by step—your highest timeline responds the moment you align inner conviction with sacred action.`;
            } 
            else if (spread.key === "fiveCard") {
                const [core, shadow, guide, action, outcome] = drawnCards;
                p1 = `${greeting} we cast the Five-Card Soul Alchemy Spread for your intention—<em>“${question}”</em>—the altar reveals an energetic field ${elementLine}. At the very center of your inquiry sits <strong>${core.position.name}</strong> through ${describeCardMeaning(core)}. Beneath the surface, however, the spread gently illuminates <strong>${shadow.position.name}</strong> via ${describeCardMeaning(shadow)}. ${majorNote} By witnessing how <strong>${core.card.name}</strong> and <strong>${shadow.card.name}</strong> converse within your psyche, you immediately dissolve unconscious resistance and reclaim the energy that was previously veiled in shadow.`;

                p2 = `In direct response, your guides step forward in <strong>${guide.position.name}</strong> offering ${describeCardMeaning(guide)}, while pointing toward <strong>${action.position.name}</strong> through ${describeCardMeaning(action)}. When you marry this spiritual counsel with grounded embodiment, the fifth pillar—<strong>${outcome.position.name}</strong>—blossoms with ${describeCardMeaning(outcome)}. Let the combined alchemy of <strong>${guide.card.name}</strong> and <strong>${outcome.card.name}</strong> remind you that your path is deeply supported; every shadow you greet with compassion transforms into golden momentum.`;
            }
            else if (spread.key === "tenCardDestiny") {
                const c = drawnCards;
                p1 = `${greeting} we open the Ten-Card Path of Destiny around your question—<em>“${question}”</em>—we witness a grand tapestry ${elementLine}. Your present vibration is anchored in <strong>${c[0].position.name}</strong> with ${describeCardMeaning(c[0])}, while <strong>${c[1].position.name}</strong> whispers through ${describeCardMeaning(c[1])}. Deeper down, <strong>${c[2].position.name}</strong> (${c[2].card.name}) and <strong>${c[3].position.name}</strong> (${c[3].card.name}) reveal the subconscious and karmic soil from which you are rising—showing ${c[2].isReversed ? c[2].card.reversed : c[2].card.upright}. As you approach the immediate gate of <strong>${c[4].position.name}</strong>, ${describeCardMeaning(c[4])}. ${majorNote}`;

                p2 = `The second half of your blueprint illuminates how to turn this threshold into mastery. In <strong>${c[5].position.name}</strong>, ${describeCardMeaning(c[5])}, which awakens your <strong>${c[6].position.name}</strong> through ${describeCardMeaning(c[6])}. By embracing <strong>${c[7].position.name}</strong> (${c[7].card.name}: <em>${c[7].card.keywords.toLowerCase()}</em>), you welcome the <strong>${c[8].position.name}</strong> heralded by ${describeCardMeaning(c[8])}. Ultimately, the tenth crown—<strong>${c[9].position.name}</strong>—seals your reading with ${describeCardMeaning(c[9])}, affirming that as you walk in sovereign alignment, your highest destiny rises to meet you.`;
            }
            else {
                // Celtic Cross (10 Cards)
                const c = drawnCards;
                p1 = `${greeting} we lay the Sacred Celtic Cross upon the altar for your inquiry—<em>“${question}”</em>—the Wheel of the Cross reveals a field ${elementLine}. At the heart of your present stands <strong>${c[0].position.name}</strong> with ${describeCardMeaning(c[0])}, directly crossed in <strong>${c[1].position.name}</strong> by ${describeCardMeaning(c[1])}. Behind you in <strong>${c[2].position.name}</strong> lies <strong>${c[2].card.name}</strong>, while <strong>${c[5].position.name}</strong> anchors your subconscious through ${describeCardMeaning(c[5])}. Overhead, <strong>${c[4].position.name}</strong> crowns your conscious aspiration with <strong>${c[4].card.name}</strong> (${c[4].card.keywords.toLowerCase()}), preparing you for <strong>${c[3].position.name}</strong> where ${describeCardMeaning(c[3])}. ${majorNote}`;

                p2 = `Ascending the Pillar of the Staff, Spirit offers clear navigation for the road ahead. In <strong>${c[6].position.name}</strong>, you are counseled by ${describeCardMeaning(c[6])}, while navigating <strong>${c[7].position.name}</strong> shaped by ${describeCardMeaning(c[7])}. Within the sacred chamber of <strong>${c[8].position.name}</strong>, ${describeCardMeaning(c[8])}—inviting you to transmute tender hesitation into trust. Finally, at the zenith of the Cross in <strong>${c[9].position.name}</strong>, the oracle reveals ${describeCardMeaning(c[9])}. Hold this transmission close to your heart: the convergence of <strong>${c[0].card.name}</strong> and <strong>${c[9].card.name}</strong> confirms that you possess both the spiritual sight and the earthly grace to fulfill this chapter in beauty.`;
            }

            document.getElementById("readingParagraph1").innerHTML = p1;
            document.getElementById("readingParagraph2").innerHTML = p2;
        }

