                counterEl.textContent = "All Cards Drawn";
                promptEl.textContent = "Unveiling your sacred spread...";
            }

            // Update Slot Pills Tray
            const tray = document.getElementById("selectedSlotsTray");
            tray.innerHTML = spread.positions.map((pos, idx) => {
                const picked = drawnCards[idx];
                if (picked) {
                    return `
