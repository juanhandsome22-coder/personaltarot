                            <!-- Front -->
                            <div class="tarot-face-front shadow-[0_10px_30px_rgba(0,0,0,0.9)] group-hover:shadow-[0_0_25px_rgba(212,175,55,0.45)] transition-shadow overflow-hidden">
                                <div class="w-full h-full ${item.isReversed ? 'rotate-180' : ''}">
                                    ${frontSVG}
                                </div>
                            </div>
