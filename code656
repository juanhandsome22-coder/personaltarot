                    const isNext = idx === drawnCards.length;
                    return `
                    <div class="flex-shrink-0 px-3 py-1.5 rounded-lg border ${isNext ? 'border-gold-400 bg-obsidian-900 text-gold-200' : 'border-gold-400/20 bg-obsidian-950/50 text-gold-200/40'} text-xs flex items-center gap-1.5">
