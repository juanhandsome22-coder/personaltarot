<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aurelia Tarot Sanctuary | Bespoke 78-Card Divination</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700&family=Cinzel:wght@400;500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
    <!-- Tone.js for subtle optional mystic chime sound effects -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        obsidian: {
                            950: '#050507',
                            900: '#0a0a0f',
                            800: '#12121a',
                            700: '#1b1b26',
                        },
                        gold: {
                            100: '#fbf6e9',
                            200: '#f3e5ab',
                            300: '#e6c875',
                            400: '#d4af37',
                            500: '#b89028',
                            600: '#997a2c',
                            700: '#6e551c',
                            800: '#463511',
                        }
                    },
                    fontFamily: {
                        display: ['"Cinzel Decorative"', 'serif'],
                        serifTitle: ['"Cinzel"', 'serif'],
                        reading: ['"Cormorant Garamond"', 'serif'],
                        sans: ['"Inter"', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        :root {
            --gold-primary: #d4af37;
            --gold-light: #f3e5ab;
            --gold-dark: #997a2c;
            --obsidian-deep: #050507;
        }

        body {
            background-color: #050507;
            color: #f3e5ab;
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
            min-height: 100vh;
        }

        /* Ambient Animated Fog & Mist Layers */
        .fog-wrapper {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 1;
            overflow: hidden;
        }

        .fog-layer {
            position: absolute;
            width: 200vw;
            height: 100vh;
            top: 0;
            left: 0;
            background: 
                radial-gradient(ellipse at 20% 50%, rgba(212, 175, 55, 0.06) 0%, transparent 55%),
                radial-gradient(ellipse at 65% 30%, rgba(160, 150, 185, 0.05) 0%, transparent 50%),
                radial-gradient(ellipse at 85% 75%, rgba(212, 175, 55, 0.05) 0%, transparent 60%);
            filter: blur(45px);
            animation: driftFog 38s linear infinite alternate;
        }

        .fog-layer-2 {
            position: absolute;
            width: 200vw;
            height: 100vh;
            bottom: -10%;
            left: -50%;
            background: 
                radial-gradient(circle at 35% 65%, rgba(243, 229, 171, 0.04) 0%, transparent 50%),
                radial-gradient(ellipse at 75% 40%, rgba(255, 255, 255, 0.035) 0%, transparent 55%);
            filter: blur(60px);
            animation: driftFogReverse 52s ease-in-out infinite alternate;
        }

        @keyframes driftFog {
            0% { transform: translate3d(-15%, 0, 0) scale(1); }
            50% { transform: translate3d(-5%, -3%, 0) scale(1.08); }
            100% { transform: translate3d(-25%, 2%, 0) scale(1.02); }
        }

        @keyframes driftFogReverse {
            0% { transform: translate3d(0%, 2%, 0) scale(1.05); }
            100% { transform: translate3d(18%, -4%, 0) scale(0.96); }
        }

        /* Luxury Gold Borders & Gradients */
        .gold-gradient-text {
            background: linear-gradient(135deg, #fbf6e9 0%, #f3e5ab 25%, #d4af37 55%, #997a2c 85%, #f3e5ab 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .gold-border-card {
            background: linear-gradient(160deg, rgba(18, 18, 26, 0.92) 0%, rgba(8, 8, 12, 0.96) 100%);
            border: 1px solid rgba(212, 175, 55, 0.28);
            box-shadow: 0 12px 40px -10px rgba(0, 0, 0, 0.85), inset 0 0 25px rgba(212, 175, 55, 0.04);
            backdrop-filter: blur(12px);
        }

        .gold-border-card:hover {
            border-color: rgba(212, 175, 55, 0.55);
        }

        .gold-btn {
            background: linear-gradient(135deg, #d4af37 0%, #997a2c 50%, #d4af37 100%);
            background-size: 200% auto;
            color: #050507;
            font-weight: 600;
            transition: all 0.35s ease;
            box-shadow: 0 0 20px rgba(212, 175, 55, 0.25);
        }

        .gold-btn:hover:not(:disabled) {
            background-position: right center;
            box-shadow: 0 0 28px rgba(243, 229, 171, 0.5);
            transform: translateY(-1px);
        }

        .gold-btn:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

        .outline-gold-btn {
            border: 1px solid rgba(212, 175, 55, 0.45);
            background: rgba(18, 18, 26, 0.75);
            color: #f3e5ab;
            transition: all 0.3s ease;
        }

        .outline-gold-btn:hover {
            border-color: #f3e5ab;
            background: rgba(212, 175, 55, 0.14);
            box-shadow: 0 0 18px rgba(212, 175, 55, 0.2);
        }

        /* 78-Card Deck Grid & Card Back Styling */
        .deck-card {
            aspect-ratio: 2 / 3.2;
            perspective: 1000px;
            cursor: pointer;
            transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.3s ease, opacity 0.3s ease;
            user-select: none;
        }

        .deck-card:hover:not(.card-picked) {
            transform: translateY(-10px) scale(1.06);
            z-index: 20;
            box-shadow: 0 12px 26px rgba(212, 175, 55, 0.38);
        }

        .deck-card.card-picked {
            opacity: 0.14;
            pointer-events: none;
            transform: scale(0.9);
            filter: grayscale(80%);
        }

        .deck-card.shuffling {
            animation: cardShufflePulse 0.55s ease-in-out;
        }

        @keyframes cardShufflePulse {
            0% { transform: translateY(0) rotate(0deg) scale(1); }
            35% { transform: translateY(-14px) rotate(-6deg) scale(0.92); }
            70% { transform: translateY(6px) rotate(6deg) scale(1.04); }
            100% { transform: translateY(0) rotate(0deg) scale(1); }
        }

        /* 3D Card Flip Container for Reveal */
        .tarot-reveal-card {
            perspective: 1200px;
        }

        .tarot-flip-inner {
            position: relative;
            width: 100%;
            height: 100%;
            transition: transform 0.85s cubic-bezier(0.4, 0.2, 0.2, 1);
            transform-style: preserve-3d;
        }

        .tarot-reveal-card.flipped .tarot-flip-inner {
            transform: rotateY(180deg);
        }

        .tarot-face-front, .tarot-face-back {
            position: absolute;
            inset: 0;
            backface-visibility: hidden;
            -webkit-backface-visibility: hidden;
            border-radius: 0.75rem;
        }

        .tarot-face-front {
            transform: rotateY(180deg);
        }

        /* Celtic Cross Visual Grid on Desktop */
        @media (min-width: 1024px) {
            .celtic-cross-board {
                display: grid;
                grid-template-columns: repeat(4, minmax(175px, 1fr));
                grid-template-rows: repeat(4, auto);
                gap: 1.25rem;
                align-items: center;
                justify-items: center;
            }
            /* Position 1 & 2 Center Cross */
            .celtic-pos-0 { grid-column: 2; grid-row: 2 / span 2; z-index: 10; }
            .celtic-pos-1 { grid-column: 2; grid-row: 2 / span 2; transform: rotate(12deg) translate(18px, 12px); z-index: 20; }
            .celtic-pos-1:hover { transform: rotate(0deg) translate(0, -6px) scale(1.04); z-index: 35; }
            /* Position 3: Past (Left) */
            .celtic-pos-2 { grid-column: 1; grid-row: 2 / span 2; }
            /* Position 4: Future (Right) */
            .celtic-pos-3 { grid-column: 3; grid-row: 2 / span 2; }
            /* Position 5: Above / Conscious (Top) */
            .celtic-pos-4 { grid-column: 2; grid-row: 1; }
            /* Position 6: Below / Subconscious (Bottom) */
            .celtic-pos-5 { grid-column: 2; grid-row: 4; }
            /* Staff Column on Right (Positions 7-10 from bottom to top) */
            .celtic-pos-6 { grid-column: 4; grid-row: 4; }
            .celtic-pos-7 { grid-column: 4; grid-row: 3; }
            .celtic-pos-8 { grid-column: 4; grid-row: 2; }
            .celtic-pos-9 { grid-column: 4; grid-row: 1; }
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #050507;
        }
        ::-webkit-scrollbar-thumb {
            background: #463511;
            border-radius: 4px;
            border: 1px solid rgba(212, 175, 55, 0.3);
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #997a2c;
        }

        /* Print styles for client reports */
        @media print {
            body {
                background: #0a0a0f !important;
                color: #f3e5ab !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body class="relative selection:bg-gold-500 selection:text-obsidian-950">

    <!-- Floating Gold Dust Canvas -->
    <canvas id="dustCanvas" class="fixed inset-0 pointer-events-none z-0"></canvas>

    <!-- Drifting Ambient Mist Overlay -->
    <div class="fog-wrapper">
        <div class="fog-layer"></div>
        <div class="fog-layer-2"></div>
    </div>

    <!-- Main Content Wrapper -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10 flex flex-col min-h-screen">

        <!-- Sanctuary Header -->
        <header class="text-center mb-8 sm:mb-10 relative">
            <div class="inline-flex items-center gap-2 px-4 py-1 rounded-full border border-gold-400/30 bg-obsidian-900/80 text-gold-300 text-xs uppercase tracking-[0.25em] mb-3">
                <span>✦</span> 78-Card Sacred Divination Sanctuary <span>✦</span>
            </div>
            <h1 class="font-display text-3xl sm:text-5xl lg:text-6xl font-bold gold-gradient-text tracking-wider mb-3">
                AURELIA TAROT
            </h1>
            <p class="font-reading italic text-lg sm:text-xl text-gold-200/80 max-w-2xl mx-auto">
                “Step through the gilded veil. Speak your question into the mist, draw from the 78 sacred archetypes, and receive your channeled reading.”
            </p>

            <!-- Top Controls Bar -->
            <div class="mt-5 flex flex-wrap items-center justify-center gap-3 no-print">
                <button id="soundToggleBtn" onclick="toggleSound()" class="outline-gold-btn px-3.5 py-1.5 rounded-full text-xs tracking-wider uppercase flex items-center gap-2">
                    <span id="soundIcon">🔔</span> <span id="soundLabel">Chimes: On</span>
                </button>
                <button onclick="openDeckEncyclopedia()" class="outline-gold-btn px-3.5 py-1.5 rounded-full text-xs tracking-wider uppercase flex items-center gap-2">
                    <span>📖</span> Inspect All 78 Cards
                </button>
                <button onclick="resetToStart()" class="outline-gold-btn px-3.5 py-1.5 rounded-full text-xs tracking-wider uppercase flex items-center gap-2">
                    <span>↺</span> Reset Altar
                </button>
            </div>

            <!-- Step Progress Indicator -->
            <div class="mt-7 max-w-xl mx-auto grid grid-cols-3 gap-2 text-xs font-serifTitle tracking-widest uppercase no-print">
                <div id="stepIndicator1" class="py-2 px-3 rounded-lg border border-gold-400 bg-gold-400/15 text-gold-200 transition-all">
                    I. Intention & Spread
                </div>
                <div id="stepIndicator2" class="py-2 px-3 rounded-lg border border-gold-400/20 bg-obsidian-900/60 text-gold-200/40 transition-all">
                    II. Draw Cards (78)
                </div>
                <div id="stepIndicator3" class="py-2 px-3 rounded-lg border border-gold-400/20 bg-obsidian-900/60 text-gold-200/40 transition-all">
                    III. Sacred Reading
                </div>
            </div>
        </header>

        <!-- ==========================================
             STEP 1: QUESTION & SPREAD SELECTION
             ========================================== -->
        <section id="step1Section" class="space-y-8 transition-all duration-500">
            <!-- Client & Question Box -->
            <div class="gold-border-card rounded-2xl p-6 sm:p-8 max-w-4xl mx-auto">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4 border-b border-gold-400/20 pb-3">
                    <div>
                        <h2 class="font-serifTitle text-xl sm:text-2xl text-gold-200 tracking-wide flex items-center gap-2">
                            <span class="text-gold-400">✧</span> 1. Whisper Your Question to the Oracle
                        </h2>
                        <p class="text-xs sm:text-sm text-gold-200/60 mt-0.5">
                            Center your breath and anchor your intention before touching the deck.
                        </p>
                    </div>
                    <div class="flex items-center gap-2">
                        <input type="text" id="clientNameInput" placeholder="Client / Querent Name (Optional)" 
                            class="bg-obsidian-950/90 border border-gold-400/30 rounded-lg px-3 py-1.5 text-xs text-gold-100 placeholder-gold-200/30 focus:outline-none focus:border-gold-400 w-52">
                    </div>
                </div>

                <div class="space-y-4">
                    <div class="relative">
                        <textarea id="questionInput" rows="3" 
                            placeholder="What is the truth I need to see regarding my path, relationship, career, or spiritual awakening right now?"
                            class="w-full bg-obsidian-950/90 border border-gold-400/35 rounded-xl p-4 text-gold-100 placeholder-gold-200/30 font-reading text-lg sm:text-xl focus:outline-none focus:border-gold-400 focus:ring-1 focus:ring-gold-400/50 transition"></textarea>
                    </div>

                    <!-- Sample Intentions + Reversed Toggle -->
                    <div class="flex flex-wrap items-center justify-between gap-4 pt-1">
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="text-xs uppercase tracking-wider text-gold-400/80 font-serifTitle">Inspire Question:</span>
                            <button type="button" onclick="fillSampleQuestion('love')" class="text-xs px-3 py-1 rounded-full border border-gold-400/30 hover:border-gold-300 bg-obsidian-900/70 text-gold-200/90 transition">
                                ♥ Love & Union
                            </button>
                            <button type="button" onclick="fillSampleQuestion('career')" class="text-xs px-3 py-1 rounded-full border border-gold-400/30 hover:border-gold-300 bg-obsidian-900/70 text-gold-200/90 transition">
                                ✦ Career & Abundance
                            </button>
                            <button type="button" onclick="fillSampleQuestion('shadow')" class="text-xs px-3 py-1 rounded-full border border-gold-400/30 hover:border-gold-300 bg-obsidian-900/70 text-gold-200/90 transition">
                                ☾ Healing & Purpose
                            </button>
                            <button type="button" onclick="fillSampleQuestion('general')" class="text-xs px-3 py-1 rounded-full border border-gold-400/30 hover:border-gold-300 bg-obsidian-900/70 text-gold-200/90 transition">
                                ✧ Highest Timeline
                            </button>
                        </div>

                        <label class="inline-flex items-center gap-2.5 cursor-pointer select-none">
                            <input type="checkbox" id="allowReversedToggle" checked class="sr-only peer">
                            <div class="w-10 h-5 bg-obsidian-950 border border-gold-400/40 rounded-full peer peer-checked:bg-gold-600/50 relative after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-gold-300 after:rounded-full after:h-3.5 after:w-3.5 after:transition-all peer-checked:after:translate-x-5"></div>
                            <span class="text-xs text-gold-200/80 tracking-wide">Include Reversed Cards</span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- 4 Sacred Spreads Selector -->
            <div class="max-w-6xl mx-auto">
                <div class="text-center mb-5">
                    <h2 class="font-serifTitle text-xl sm:text-2xl text-gold-200 tracking-wide">
                        <span class="text-gold-400">✧</span> 2. Choose Your Sacred Spread
                    </h2>
                    <p class="text-xs sm:text-sm text-gold-200/60 mt-1">
                        Select the sacred geometry layout that matches the depth of your inquiry.
                    </p>
                </div>

                <div id="spreadCardsContainer" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
                    <!-- Populated dynamically via JS -->
                </div>

                <!-- Proceed Button -->
                <div class="mt-8 text-center">
                    <button id="beginRitualBtn" onclick="proceedToDeck()" class="gold-btn px-8 py-4 rounded-xl font-serifTitle text-base sm:text-lg tracking-widest uppercase inline-flex items-center gap-3">
                        <span> Approach the 78-Card Altar </span>
                        <span>→</span>
                    </button>
                    <p id="step1ValidationMsg" class="text-amber-300/90 text-xs mt-2.5 h-4 font-sans"></p>
                </div>
            </div>
        </section>

        <!-- ==========================================
             STEP 2: INTERACTIVE 78-CARD SELECTION
             ========================================== -->
        <section id="step2Section" class="hidden space-y-6 transition-all duration-500">
            <!-- Sticky Altar Header -->
            <div class="gold-border-card rounded-2xl p-4 sm:p-6 sticky top-3 z-30">
                <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
                    <div>
                        <div class="flex items-center gap-2 text-xs text-gold-400 uppercase tracking-widest font-serifTitle">
                            <span id="activeSpreadBadge">3-Card Spread</span>
                            <span>•</span>
                            <span id="cardsRemainingCounter" class="text-gold-200 font-semibold">Select 3 Cards</span>
                        </div>
                        <h2 id="currentPromptPosition" class="font-serifTitle text-lg sm:text-xl text-gold-100 mt-1">
                            Draw Card 1: The Past
                        </h2>
                        <p id="activeQuestionDisplay" class="font-reading italic text-gold-200/75 text-sm sm:text-base line-clamp-1 mt-0.5"></p>
                    </div>

                    <div class="flex flex-wrap items-center gap-2.5">
                        <button onclick="shuffleDeckVisual()" class="outline-gold-btn px-4 py-2 rounded-xl text-xs font-serifTitle tracking-wider uppercase flex items-center gap-2">
                            <span>✧</span> Shuffle 78 Cards
                        </button>
                        <button onclick="autoDrawRemaining()" class="gold-btn px-4 py-2 rounded-xl text-xs font-serifTitle tracking-wider uppercase flex items-center gap-2">
                            <span>⚡</span> Quick Draw Remaining
                        </button>
                        <button onclick="backToStep1()" class="outline-gold-btn px-3 py-2 rounded-xl text-xs font-serifTitle tracking-wider uppercase">
                            Change Spread
                        </button>
                    </div>
                </div>

                <!-- Selected Slots Tray -->
                <div id="selectedSlotsTray" class="mt-4 pt-3 border-t border-gold-400/20 flex items-center gap-2 overflow-x-auto pb-1">
                    <!-- Dynamic slot pills -->
                </div>
            </div>

            <!-- The 78 Tarot Cards Spread Across the Altar -->
            <div class="gold-border-card rounded-2xl p-4 sm:p-6">
                <div class="flex items-center justify-between mb-4">
                    <span class="text-xs uppercase tracking-widest text-gold-400/80 font-serifTitle">
                        78 Sacred Arcana Deck (22 Major • 56 Minor) — Click Any Card to Draw
                    </span>
                    <span class="text-xs text-gold-200/60 hidden sm:inline">
                        Let your intuition guide your cursor
                    </span>
                </div>

                <div id="deckGrid78" class="grid grid-cols-6 sm:grid-cols-10 md:grid-cols-13 lg:grid-cols-13 gap-2 sm:gap-2.5">
                    <!-- All 78 face-down cards rendered here -->
                </div>
            </div>
        </section>

        <!-- ==========================================
             STEP 3: SPREAD REVEAL & 2-PARAGRAPH READING
             ========================================== -->
        <section id="step3Section" class="hidden space-y-8 transition-all duration-500">
            <!-- Reading Banner & Controls -->
            <div class="gold-border-card rounded-2xl p-6 sm:p-8">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-gold-400/20 pb-5">
                    <div>
                        <div class="text-xs uppercase tracking-[0.2em] text-gold-400 font-serifTitle mb-1" id="revealSpreadTitle">
                            Sacred Spread
                        </div>
                        <h2 class="font-serifTitle text-2xl sm:text-3xl gold-gradient-text" id="revealClientHeading">
                            Oracle Transmission
                        </h2>
                        <p class="font-reading italic text-lg sm:text-xl text-gold-200/90 mt-1" id="revealQuestionText"></p>
                    </div>

                    <div class="flex flex-wrap items-center gap-2.5 no-print">
                        <button onclick="copyReadingForClient()" class="gold-btn px-4 py-2.5 rounded-xl text-xs font-serifTitle tracking-wider uppercase flex items-center gap-2">
                            <span>📋</span> Copy Reading for Client
                        </button>
                        <button onclick="window.print()" class="outline-gold-btn px-4 py-2.5 rounded-xl text-xs font-serifTitle tracking-wider uppercase flex items-center gap-2">
                            <span>🖨️</span> Print / Save PDF
                        </button>
                        <button onclick="resetToStart()" class="outline-gold-btn px-4 py-2.5 rounded-xl text-xs font-serifTitle tracking-wider uppercase flex items-center gap-2">
                            <span>✦</span> New Reading
                        </button>
                    </div>
                </div>

                <!-- Drawn Cards Visual Spread Board -->
                <div class="mt-6">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="font-serifTitle text-sm uppercase tracking-widest text-gold-300">
                            ✦ Drawn Arcana Layout (Click any card to inspect deep symbology)
                        </h3>
                        <span class="text-xs text-gold-200/60" id="elementalBalanceBadge"></span>
                    </div>

                    <div id="spreadVisualBoard" class="my-4">
                        <!-- Cards rendered in 3-card, 5-card, 10-card, or Celtic Cross layout -->
                    </div>
                </div>
            </div>

            <!-- THE 2-PARAGRAPH SYNTHESIZED ORACLE READING -->
            <div class="gold-border-card rounded-2xl p-6 sm:p-10 relative overflow-hidden">
                <!-- Decorative corner flourishes -->
                <div class="absolute top-3 left-3 text-gold-400/30 text-xl select-none">╔</div>
                <div class="absolute top-3 right-3 text-gold-400/30 text-xl select-none">╗</div>
                <div class="absolute bottom-3 left-3 text-gold-400/30 text-xl select-none">╚</div>
                <div class="absolute bottom-3 right-3 text-gold-400/30 text-xl select-none">╝</div>

                <div class="max-w-4xl mx-auto">
                    <div class="text-center mb-6">
                        <span class="text-xs uppercase tracking-[0.25em] text-gold-400 font-serifTitle">Synthesized Divination</span>
                        <h3 class="font-display text-2xl sm:text-3xl gold-gradient-text mt-1">
                            Your Two-Part Channeled Reading
                        </h3>
                        <div class="w-32 h-px bg-gradient-to-r from-transparent via-gold-400 to-transparent mx-auto mt-3"></div>
                    </div>

                    <div class="space-y-6 font-reading text-xl sm:text-2xl leading-relaxed text-gold-100/95">
                        <!-- Paragraph 1: Energetic Roots, Past & Current Crossroads -->
                        <div class="p-5 sm:p-7 rounded-xl bg-obsidian-950/75 border border-gold-400/25 shadow-inner">
                            <div class="text-xs font-serifTitle uppercase tracking-widest text-gold-400 mb-2 flex items-center gap-2">
                                <span>I.</span> <span>Energetic Foundation & Current Crossroads</span>
                            </div>
                            <p id="readingParagraph1" class="indent-6 text-justify sm:text-left"></p>
