        function copyReadingForClient() {
            const spread = SPREADS[selectedSpreadKey];
            const question = document.getElementById("questionInput").value.trim();
            const clientName = document.getElementById("clientNameInput").value.trim() || "Sacred Querent";
            const p1 = document.getElementById("readingParagraph1").innerText;
