            const q = query.toLowerCase().trim();
            const filtered = FULL_TAROT_DECK.filter(c => 
                c.name.toLowerCase().includes(q) || 
                c.keywords.toLowerCase().includes(q) ||
                c.element.toLowerCase().includes(q)
