                if (item.card.suit === "Major") counts.Major++;
            });
            document.getElementById("elementalBalanceBadge").innerHTML = 
                `Major Arcana: <strong class="text-gold-300">${counts.Major}</strong> • Fire: ${counts.Fire} • Water: ${counts.Water} • Air: ${counts.Air} • Earth: ${counts.Earth}`;

            // Layout classes depending on spread
            let gridClass = "grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-4xl mx-auto";
            if (spread.key === "fiveCard") {
                gridClass = "grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-5 gap-4";
            } else if (spread.key === "tenCardDestiny") {
