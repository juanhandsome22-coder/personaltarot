        function pickCardFromAltar(deckIndex) {
            const spread = SPREADS[selectedSpreadKey];
            if (drawnCards.length >= spread.count) return;

            const cardEl = document.getElementById(`altarCard-${deckIndex}`);
            if (!cardEl || cardEl.classList.contains("card-picked")) return;

            cardEl.classList.add("card-picked");

            const allowReversed = document.getElementById("allowReversedToggle").checked;
            const isReversed = allowReversed ? Math.random() < 0.28 : false;
            const positionObj = spread.positions[drawnCards.length];
            const chosenCard = shuffledDeck[deckIndex];

            drawnCards.push({
                card: chosenCard,
                isReversed: isReversed,
                position: positionObj,
                deckIndex: deckIndex
            });

            // Ascending chime note
            playMysticTone(440 + drawnCards.length * 45, "8n");
            updateAltarProgressUI();

            if (drawnCards.length === spread.count) {
                setTimeout(() => {
                    revealReadingStep3();
                }, 480);
            }
        }

        function autoDrawRemaining() {
            const spread = SPREADS[selectedSpreadKey];
            const availableIndices = [];
            shuffledDeck.forEach((_, idx) => {
                const el = document.getElementById(`altarCard-${idx}`);
                if (el && !el.classList.contains("card-picked")) {
                    availableIndices.push(idx);
                }
            });

            // Shuffle available indices
            for (let i = availableIndices.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [availableIndices[i], availableIndices[j]] = [availableIndices[j], availableIndices[i]];
            }

            const needed = spread.count - drawnCards.length;
            for (let k = 0; k < needed; k++) {
                setTimeout(() => {
                    pickCardFromAltar(availableIndices[k]);
                }, k * 110);
            }
        }

        /* ============================================================================
           8. STEP 3: SPREAD REVEAL & 2-PARAGRAPH SYNTHESIZED READING GENERATOR
