            board.className = gridClass;
            board.innerHTML = drawnCards.map((item, idx) => {
                const celticPosClass = spread.key === "celticCross" ? `celtic-pos-${idx}` : "";
                const frontSVG = getCardFrontSVG(item.card);
                const backSVG = getCardBackSVG();

                return `
                <div class="${celticPosClass} flex flex-col items-center w-full max-w-[220px] mx-auto">
                    <div class="text-center mb-2">
                        <span class="text-[11px] font-serifTitle uppercase tracking-wider text-gold-400 block">
                            ${item.position.name}
                        </span>
                        <span class="text-[10px] text-gold-200/60 block">${item.position.role}</span>
                    </div>

                    <div id="revealCard-${idx}" onclick="inspectDrawnCard(${idx})" 
                        class="tarot-reveal-card w-44 sm:w-48 aspect-[2/3] cursor-pointer group">
                        <div class="tarot-flip-inner">
                            <!-- Back initially visible before flip animation -->
                            <div class="tarot-face-back shadow-xl">
                                ${backSVG}
