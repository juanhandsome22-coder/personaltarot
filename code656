                            ? 'bg-amber-900/40 text-amber-300 border border-amber-500/30' 
                            : 'bg-gold-500/15 text-gold-300 border border-gold-400/30'
                        }">
                            ${item.isReversed ? 'Reversed ↺' : 'Upright ↑'}
